{
  "name": "admin-survey",
  "version": "1.0.0",
  "description": "Lambda CRUD para gestión de encuestas",
  "main": "dist/handler.js",
  "scripts": {
    "build": "esbuild src/handler.ts --bundle --platform=node --target=node20 --outfile=dist/handler.js --external:@aws-sdk/*",
    "package": "npm run build && cd dist && zip -r ../function.zip . && echo '✅ function.zip'",
    "type-check": "../../node_modules/.bin/tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.161",
    "@types/node": "^20.19.40",
    "@types/uuid": "^9.0.8",
    "esbuild": "^0.20.2",
    "typescript": "^5.9.3"
  }
}
